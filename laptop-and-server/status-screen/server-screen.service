[Unit]
Description=Status screen: page + stats API on 127.0.0.1:7800
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/code/status-screen/server.py
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
Nice=5
MemoryMax=200M

[Install]
WantedBy=default.target
