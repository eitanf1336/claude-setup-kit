#!/usr/bin/env python3
"""Restart the server's kiosk when its page stops talking to the status server.

Why: a kiosk browser's renderer can wedge (we saw one frozen for 5 days) and a JS watchdog cannot help
when the whole renderer is stuck, so this runs OUTSIDE the page: the page sends ?role=main with every
/api/sync and /api/stats call, the server remembers when, and /api/health reports it. If the page has been
silent for 3 minutes (and the screen is not asleep) we kill cage; tty1 then logs out, autologin starts
the kiosk again with a fresh browser. Run every minute by kiosk-watchdog.timer.
"""
import json, os, subprocess, sys, time, urllib.request

ROLE, SILENT_S, MIN_AGE_S = (sys.argv[1:] or ['main'])[0], 180, 300
LOG = os.path.expanduser('~/.local/state/kiosk-watchdog.log')


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, 'a') as f:
        f.write(time.strftime('%F %T ') + msg + '\n')


if os.path.exists(os.path.expanduser('~/.config/server-kiosk-off')):
    sys.exit(0)
try:
    h = json.load(urllib.request.urlopen('http://127.0.0.1:7800/api/health', timeout=5))
except Exception:
    sys.exit(0)            # server.py down or restarting: systemd handles that, the page reconnects alone
if h.get('blank'):
    sys.exit(0)
pids = subprocess.run(['pgrep', '-x', 'cage'], capture_output=True, text=True).stdout.split()
if not pids:
    sys.exit(0)
age = int(subprocess.run(['ps', '-o', 'etimes=', '-p', pids[0]], capture_output=True, text=True).stdout.strip() or 0)
ago = (h.get('page_seen_ago') or {}).get(ROLE)
silent = age if ago is None else ago      # never heard from this page since server.py started: count from cage's start
if silent > SILENT_S and age > MIN_AGE_S:
    log(f'page silent {silent:.0f}s (cage up {age}s): restarting the kiosk')
    subprocess.run(['pkill', '-x', 'cage'])
    time.sleep(3)
    subprocess.run(['pkill', '-f', 'chromium'])
