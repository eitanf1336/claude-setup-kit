#!/bin/bash
# Full-screen status screen on the server's own display.
# Install: sudo apt install cage chromium (or chromium-browser) curl brightnessctl
#          copy to ~/bin/server-kiosk, and have tty1 autologin start it (see getty-tty1-autologin.conf
#          and add `[ "$(tty)" = /dev/tty1 ] && exec ~/bin/server-kiosk` to ~/.bash_profile).
# Disable without uninstalling: touch ~/.config/server-kiosk-off  (kiosk-watchdog then leaves it alone)
[ -e "$HOME/.config/server-kiosk-off" ] && exit 0
brightnessctl -q set 30% 2>/dev/null
until curl -s -m 2 http://127.0.0.1:7800/ >/dev/null; do sleep 2; done
exec cage -d -- chromium --kiosk --ozone-platform=wayland --noerrdialogs --disable-infobars \
  --no-first-run --password-store=basic --disable-features=Translate,TranslateUI \
  --disable-session-crashed-bubble --check-for-update-interval=31536000 \
  --app=http://127.0.0.1:7800/
