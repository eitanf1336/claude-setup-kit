#!/usr/bin/env bash
# server-disk-guard: keep the server's disk from ever filling up again.
#
# Why: a full root disk is silent. Every service still says "active" while writes fail
# ("database or disk is full") and bots or databases quietly stop working for hours.
#
# What it does, every 10 minutes (server-disk-guard.timer):
#   1. Below PRUNE_GB free: deletes only things that regenerate on their own
#      (journal beyond 300M, apt cache, uv/pip caches, Trash, Claude Code
#      versions no process is running). Never touches project data.
#   2. Still below WARN_GB: runs your alert command (see ALERT_CMD below), once a day.
#   3. Below CRIT_GB: the same, every 2 hours, marked CRITICAL.
# Alert: set ALERT_CMD in ~/.config/laptop-and-server/config, e.g.
#   ALERT_CMD='ssh laptop notify-send -u critical "$ALERT_TITLE" "$ALERT_MSG"'
# The command gets ALERT_TITLE and ALERT_MSG in its environment. No ALERT_CMD = log only.
# Log: ~/.local/state/server-disk-guard/log

set -uo pipefail
[ -f "$HOME/.config/laptop-and-server/config" ] && . "$HOME/.config/laptop-and-server/config"
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"

PRUNE_GB=${PRUNE_GB:-20}
WARN_GB=${WARN_GB:-20}
CRIT_GB=${CRIT_GB:-8}
STATE="$HOME/.local/state/server-disk-guard"
LOG="$STATE/log"
mkdir -p "$STATE"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
[[ -f "$LOG" && $(stat -c%s "$LOG") -gt 500000 ]] && { tail -n 1000 "$LOG" >"$LOG.t" && mv "$LOG.t" "$LOG"; }

free_gb() { df -BG --output=avail / | tail -1 | tr -dc '0-9'; }

before=$(free_gb)
if (( before < PRUNE_GB )); then
    sudo -n journalctl --vacuum-size=300M >/dev/null 2>&1
    sudo -n apt-get clean >/dev/null 2>&1
    rm -rf "$HOME/.cache/uv" "$HOME/.cache/pip" 2>/dev/null
    rm -rf "$HOME/.local/share/Trash/files/"* "$HOME/.local/share/Trash/info/"* 2>/dev/null
    # Claude Code versions: keep the current target and anything a live process runs.
    vdir="$HOME/.local/share/claude/versions"
    if [[ -d "$vdir" ]]; then
        keep=$(readlink -f "$HOME/.local/bin/claude" 2>/dev/null)
        inuse=$(timeout 30 find /proc -mindepth 2 -maxdepth 2 -name exe -lname "$vdir/*" -printf '%l\n' 2>/dev/null | sed 's/ (deleted)$//' | sort -u)
        for v in "$vdir"/*; do
            [[ "$v" == "$keep" ]] && continue
            grep -qxF "$v" <<<"$inuse" && continue
            rm -rf "$v" && log "pruned old claude version $(basename "$v")"
        done
    fi
    after=$(free_gb)
    log "low disk: ${before}G free, pruned caches, now ${after}G"
else
    after=$before
fi

(( after >= WARN_GB )) && exit 0

if (( after < CRIT_GB )); then level=CRITICAL; every=7200; else level=LOW; every=86400; fi
stamp="$STATE/last-alert-$level"
last=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
(( $(date +%s) - last < every )) && exit 0

top=$(timeout 300 du -xh --max-depth=3 "$HOME" 2>/dev/null | sort -rh | awk 'NR>1 && NR<=7 {sub("'"$HOME"'/","~/",$2); printf "%s %s, ", $1, $2}' | sed 's/, $//')
msg="Server disk $level: only ${after}G free. When it hits 0 every service on the server stops working. Biggest: $top"
log "ALERT: $msg"
touch "$stamp"

if [ -n "${ALERT_CMD:-}" ]; then
    ALERT_TITLE="Server disk $level" ALERT_MSG="$msg" bash -c "$ALERT_CMD" >/dev/null 2>&1 || log "alert command failed"
fi
exit 0
