+// sendReaction reacts to a stored message with an emoji. An empty emoji removes
+// a previous reaction; sending a different one replaces it, since WhatsApp keeps
+// only one reaction per sender per message.
+//
+// The target's sender is resolved from the local store rather than taken from
+// the caller. The messages table records `sender` as a bare user part with no
+// server (msg.Info.Sender.User), and types.ParseJID on a bare number returns a
+// JID with an EMPTY User and the number as the *server*. Feeding that to
+// BuildMessageKey would mark the reaction as pointing at someone else's message
+// and attach a garbage participant, so the reaction would silently land on
+// nothing. For our own messages an empty JID is the documented way to say
+// "mine", BuildMessageKey then keeps FromMe=true and omits the participant.
+func sendReaction(client *whatsmeow.Client, messageStore *MessageStore, chatJID, messageID, emoji string) (bool, string) {
+	chat, err := types.ParseJID(chatJID)
+	if err != nil {
+		return false, fmt.Sprintf("invalid chat jid: %v", err)
+	}
+
+	var storedSender string
+	var fromMe bool
+	err = messageStore.db.QueryRow(
+		"SELECT sender, is_from_me FROM messages WHERE id = ? AND chat_jid = ?",
+		messageID, chatJID).Scan(&storedSender, &fromMe)
+	if err != nil {
+		return false, fmt.Sprintf("unknown message %s in %s: %v", messageID, chatJID, err)
+	}
+
+	sender := types.EmptyJID
+	if !fromMe {
+		if strings.Contains(storedSender, "@") {
+			if sender, err = types.ParseJID(storedSender); err != nil {
+				return false, fmt.Sprintf("invalid sender jid %q: %v", storedSender, err)
+			}
+		} else {
+			// Bare user part: pick the server it belongs to. Group senders are
+			// increasingly LIDs rather than phone numbers.
+			server := types.DefaultUserServer
+			if lid := client.Store.GetLID(); !lid.IsEmpty() && lid.User == storedSender {
+				server = types.HiddenUserServer
+			}
+			sender = types.NewJID(storedSender, server)
+		}
+	}
+
+	resp, err := client.SendMessage(context.Background(), chat,
+		client.BuildReaction(chat, sender, messageID, emoji))
+	if err != nil {
+		return false, fmt.Sprintf("failed to send reaction: %v", err)
+	}
+	return true, fmt.Sprintf("reacted %q to %s (id %s)", emoji, messageID, resp.ID)
+}
