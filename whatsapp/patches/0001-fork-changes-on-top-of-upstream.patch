+            "role": "assistant",
+            "text": text,
+        }
+        if msg_id:
+            rec["ids"] = [msg_id]
+        if media:
+            rec["media"] = media
+        line = json.dumps(rec, ensure_ascii=False) + "\n"
+        if _remote():
+            # The app and the bot read the log on the bridge's machine.
+            import subprocess
+            subprocess.run(["ssh", "-o", "BatchMode=yes", REMOTE_HOST,
+                            "cat >> ~/.config/claude-whatsapp/history.jsonl"],
+                           input=line.encode("utf-8"), check=True, timeout=30)
+            return
+        with open(CLAUDE_HISTORY_FILE, "a", encoding="utf-8") as f:
+            f.write(line)
+    except Exception as e:
+        print(f"history mirror failed: {e}")
