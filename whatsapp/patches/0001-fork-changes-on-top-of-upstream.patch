+func extractChoiceText(msg *waProto.Message) string {
+	var b strings.Builder
+	line := func(s string) {
+		if s = strings.TrimSpace(s); s != "" {
+			if b.Len() > 0 {
+				b.WriteString("\n")
+			}
+			b.WriteString(s)
+		}
+	}
+	if l := msg.GetListMessage(); l != nil {
+		line(l.GetTitle())
+		line(l.GetDescription())
+		line(l.GetFooterText())
+		for _, sec := range l.GetSections() {
+			line(sec.GetTitle())
+			for _, r := range sec.GetRows() {
+				line("[choice] " + r.GetTitle() + "  " + r.GetDescription())
+			}
+		}
+		if l.GetButtonText() != "" {
+			line("(list button: " + l.GetButtonText() + ")")
+		}
+	}
+	if bm := msg.GetButtonsMessage(); bm != nil {
+		line(bm.GetContentText())
+		line(bm.GetFooterText())
+		for _, btn := range bm.GetButtons() {
+			line("[choice] " + btn.GetButtonText().GetDisplayText())
+		}
+	}
+	if tm := msg.GetTemplateMessage(); tm != nil {
+		ht := tm.GetHydratedTemplate()
+		line(ht.GetHydratedTitleText())
+		line(ht.GetHydratedContentText())
+		line(ht.GetHydratedFooterText())
+		for _, hb := range ht.GetHydratedButtons() {
+			if q := hb.GetQuickReplyButton(); q != nil {
+				line("[choice] " + q.GetDisplayText())
+			} else if u := hb.GetUrlButton(); u != nil {
+				line("[link] " + u.GetDisplayText() + " " + u.GetURL())
+			}
+		}
+	}
+	if im := msg.GetInteractiveMessage(); im != nil {
+		line(im.GetHeader().GetTitle())
+		line(im.GetBody().GetText())
+		line(im.GetFooter().GetText())
+		for _, nb := range im.GetNativeFlowMessage().GetButtons() {
+			var p struct {
+				DisplayText string `json:"display_text"`
+				Title       string `json:"title"`
+				Sections    []struct {
+					Title string `json:"title"`
+					Rows  []struct {
+						Title       string `json:"title"`
+						Description string `json:"description"`
+					} `json:"rows"`
+				} `json:"sections"`
+			}
+			_ = json.Unmarshal([]byte(nb.GetButtonParamsJSON()), &p)
+			if p.DisplayText != "" {
+				line("[choice] " + p.DisplayText)
+			}
+			if p.Title != "" {
+				line("(menu: " + p.Title + ")")
+			}
+			for _, sec := range p.Sections {
+				line(sec.Title)
+				for _, r := range sec.Rows {
+					line("[choice] " + r.Title + "  " + r.Description)
+				}
+			}
+		}
+	}
+	if r := msg.GetListResponseMessage(); r != nil {
+		line(r.GetTitle())
+	}
+	if r := msg.GetButtonsResponseMessage(); r != nil {
+		line(r.GetSelectedDisplayText())
+	}
+	return b.String()
+}
