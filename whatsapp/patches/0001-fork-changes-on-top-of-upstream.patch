+def _mirror_to_claude_history(recipient: str, text: str, msg_id: str = "", media: str = "") -> None:
+    """Best-effort: a failure here must never turn a successful send into an error."""
+    if not CLAUDE_GROUP_JID or recipient != CLAUDE_GROUP_JID:
+        return
+    try:
