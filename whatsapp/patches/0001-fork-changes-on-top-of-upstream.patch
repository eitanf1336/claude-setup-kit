+// resolveRecipientJID turns the recipient field of a send request into the chat
+// JID the local store keys messages by. Same rules the sender uses, kept in one
+// place so a stored message can never land under a different JID than the one
+// it was actually sent to.
+func resolveRecipientJID(recipient string) (types.JID, error) {
+	if strings.Contains(recipient, "@") {
+		return types.ParseJID(recipient)
+	}
+	return types.JID{User: recipient, Server: "s.whatsapp.net"}, nil
+}
+
+// resolveParticipant turns a bare/stored sender (just the user part, as kept in
+// our messages DB) into a full JID suitable for a reply's ContextInfo.Participant.
+// It reattaches the right server by matching our own identities, which covers the
+// self-group case where every message is from us, and falls back to the default
+// phone server otherwise.
+func resolveParticipant(client *whatsmeow.Client, sender string) string {
+	if sender == "" {
+		return ""
+	}
+	if strings.Contains(sender, "@") {
+		return sender
+	}
+	if client.Store.LID.User == sender {
+		return client.Store.LID.String()
+	}
+	if client.Store.ID != nil && client.Store.ID.User == sender {
+		return client.Store.ID.String()
+	}
+	return sender + "@" + types.DefaultUserServer
 }
 
