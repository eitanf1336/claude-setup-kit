+// markChatUnread flips a chat to "unread" on WhatsApp (the badge syncs to the
+// phone) by sending a mark-chat-as-read app-state patch with read=false,
+// anchored at the chat's most recent stored message. WhatsApp lets you mark a
+// chat unread even when you sent the last message yourself, which is exactly
+// the case for the bot's self-group replies.
+func markChatUnread(client *whatsmeow.Client, messageStore *MessageStore, jidStr string) error {
+	jid, err := types.ParseJID(jidStr)
+	if err != nil {
+		return fmt.Errorf("parse jid: %v", err)
+	}
+	var id string
+	var fromMe bool
+	var ts time.Time
+	err = messageStore.db.QueryRow(
+		"SELECT id, is_from_me, timestamp FROM messages WHERE chat_jid = ? ORDER BY timestamp DESC LIMIT 1",
+		jidStr).Scan(&id, &fromMe, &ts)
+	if err != nil {
+		return fmt.Errorf("no anchor message for %s: %v", jidStr, err)
+	}
+	key := &waCommon.MessageKey{
+		RemoteJID: proto.String(jidStr),
+		FromMe:    proto.Bool(fromMe),
+		ID:        proto.String(id),
+	}
+	return client.SendAppState(context.Background(),
+		appstate.BuildMarkChatAsRead(jid, false, ts, key))
+}
