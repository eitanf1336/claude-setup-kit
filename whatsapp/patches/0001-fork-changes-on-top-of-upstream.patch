+// keepSentMedia parks a copy of a sent file in a cache the history log can
+// safely point at forever, and keeps that cache under a size ceiling by
+// dropping the oldest copies. Returns "" when the copy failed, in which case
+// the caller logs the original path: a possibly-stale attachment still beats no
+// attachment at all.
+func keepSentMedia(src string) string {
+	dir := os.Getenv("BRIDGE_MEDIA_KEEP_DIR")
+	if dir == "" {
+		return ""
+	}
+	if strings.HasPrefix(src, dir+string(os.PathSeparator)) {
+		return src // already ours, sending it again shouldn't clone it
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		fmt.Println("media keep: cannot create dir:", err)
+		return ""
+	}
+	in, err := os.Open(src)
+	if err != nil {
+		return ""
+	}
+	defer in.Close()
+	dst := filepath.Join(dir, fmt.Sprintf("%d-%s", time.Now().UnixMilli(), filepath.Base(src)))
+	out, err := os.Create(dst)
+	if err != nil {
+		fmt.Println("media keep: cannot write:", err)
+		return ""
+	}
+	if _, err := io.Copy(out, in); err != nil {
+		out.Close()
+		os.Remove(dst)
+		fmt.Println("media keep: copy failed:", err)
+		return ""
+	}
+	out.Close()
+	pruneSentMedia(dir)
+	return dst
+}
+
+// pruneSentMedia drops the oldest kept copies once the cache passes its ceiling
+// (2 GB by default, roughly a hundred APKs). Old attachments in a companion UI then
+// stop downloading, which is the right trade against filling the disk.
+func pruneSentMedia(dir string) {
+	limit := int64(2 << 30)
+	if v := os.Getenv("BRIDGE_MEDIA_KEEP_BYTES"); v != "" {
+		if n, err := strconv.ParseInt(v, 10, 64); err == nil && n > 0 {
+			limit = n
+		}
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return
+	}
+	type kept struct {
+		path string
+		mod  time.Time
+		size int64
+	}
+	var files []kept
+	var total int64
+	for _, e := range entries {
+		info, ierr := e.Info()
+		if ierr != nil || e.IsDir() {
+			continue
+		}
+		files = append(files, kept{filepath.Join(dir, e.Name()), info.ModTime(), info.Size()})
+		total += info.Size()
+	}
+	if total <= limit {
+		return
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].mod.Before(files[j].mod) })
+	for _, f := range files {
+		if total <= limit {
+			return
+		}
+		if err := os.Remove(f.path); err == nil {
+			total -= f.size
+			fmt.Println("media keep: pruned", filepath.Base(f.path))
+		}
+	}
+}
