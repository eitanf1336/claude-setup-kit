 // Start a REST API server to expose the WhatsApp client functionality
 func startRESTServer(client *whatsmeow.Client, messageStore *MessageStore, port int) {
+	// Health probe. A running process is not the same as a working bridge: the
+	// phone can unlink this device, or the socket can drop, and the binary
+	// happily stays alive doing nothing. Watchdogs need to see *link* state,
+	// not just a pid, so they can shout for a re-scan instead of reporting
+	// "healthy" while every message is silently dropped.
+	http.HandleFunc("/api/status", func(w http.ResponseWriter, r *http.Request) {
+		jid := ""
+		pushName := ""
+		if client.Store != nil {
+			if client.Store.ID != nil {
+				jid = client.Store.ID.String()
+			}
+			pushName = client.Store.PushName
+		}
