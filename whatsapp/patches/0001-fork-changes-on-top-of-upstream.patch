+// appendMediaHistory records a file sent into the watched chat in the bot's
+// history log. A companion phone UI reads that log and nothing else, so a file missing
+// from it is invisible on the phone no matter who sent it: the bot, this API, or
+// a Claude session going through the MCP tools. Only the text of a message was
+// ever logged, which is exactly why every APK sent into the group vanished.
+// Best-effort by design: a failure here must never fail the send.
+func appendMediaHistory(recipientJID, mediaPath, caption, role, id string) {
+	logPath := os.Getenv("BRIDGE_MEDIA_LOG")
+	want := os.Getenv("BRIDGE_MEDIA_LOG_JID")
+	if logPath == "" || want == "" || recipientJID != want || mediaPath == "" {
+		return
+	}
+	abs, err := filepath.Abs(mediaPath)
+	if err != nil {
+		abs = mediaPath
+	}
+	// Label it with the name he sent it under, before the path turns into a
+	// cache copy with a timestamp glued to the front.
+	text := strings.TrimSpace(caption)
+	if text == "" {
+		text = "📎 " + filepath.Base(abs)
+	}
+	// Point the log at a copy we control. Files are usually sent straight out of
+	// a build directory or /tmp, so by the time he taps the attachment the path
+	// is gone or, worse, holds the *next* build under the same name.
+	if kept := keepSentMedia(abs); kept != "" {
+		abs = kept
+	}
+	if role != "user" {
+		role = "assistant"
+	}
+	rec := map[string]interface{}{
+		"ts":    time.Now().Format("2006-01-02 15:04:05"),
+		"role":  role,
+		"text":  text,
+		"media": abs,
+	}
+	if id != "" {
+		rec["ids"] = []string{id}
+	}
+	line, merr := json.Marshal(rec)
+	if merr != nil {
+		fmt.Println("media log: cannot encode:", merr)
+		return
+	}
+	f, ferr := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if ferr != nil {
+		fmt.Println("media log: cannot open:", ferr)
+		return
+	}
+	defer f.Close()
+	// One write of one short line, so an append here can't interleave with the
+	// bot appending to the same file from its own process.
+	if _, werr := f.Write(append(line, '\n')); werr != nil {
+		fmt.Println("media log: cannot write:", werr)
+		return
+	}
+	fmt.Println("media log: recorded", filepath.Base(abs))
+}
