#!/usr/bin/env python3
"""wa-history, print recent "My Claude" group chat history (read-only).

Context helper for the WhatsApp bot's per-message Claude runs: instead of one
ever-growing --resume session (which replays the whole transcript every turn and
burns tokens), each Claude gets a *bounded window* of recent history here, and
can ask for more by raising --limit or paging with --before.

Source of truth, in order:
  1) the bot's own transcript  ~/.config/claude-whatsapp/history.jsonl
     (has BOTH sides, your messages AND Claude's replies)
  2) fallback: the whatsapp bridge store (your side only; the bridge does not
     persist messages the bot sends).

Prints oldest -> newest. Default limit 25.
"""
import argparse, json, os, sqlite3, sys

HOME = os.path.expanduser("~")
TRANSCRIPT = os.environ.get("CWB_HISTORY_FILE",
                            os.path.join(HOME, ".config/claude-whatsapp/history.jsonl"))
BRIDGE_DB = os.environ.get("CWB_MESSAGES_DB",
                           os.path.join(os.environ.get("WA_REPO", os.path.join(HOME, "code/whatsapp-mcp")), "whatsapp-bridge/store/messages.db"))
def _default_chat():
    """Control-group JID: env override, else whatever the bot recorded in its state file."""
    j = os.environ.get("CWB_GROUP_JID", "")
    if j:
        return j
    try:
        with open(os.path.join(HOME, ".config/claude-whatsapp/state.json"), encoding="utf-8") as f:
            return json.load(f).get("group_jid", "")
    except Exception:
        return ""


DEFAULT_CHAT = _default_chat()
MARKER = "🤖"


# Older bot versions stored a failed run's raw stdout tail as the assistant's
# turn, so half a kilobyte of result JSON sat in the transcript and was fed back
# as "context" to every later run. The bot no longer writes these, but the ones
# already on disk still eat slots in the window, so drop them on read.
CRASH_DUMP_MARKERS = ("cacheCreationInputTokens", '"costUSD"', "terminal_reason",
                      "Could not parse claude output")


def is_crash_dump(r):
    if r.get("role") != "assistant":
        return False
    text = r.get("text") or ""
    return (text.startswith("(claude exited ")
            or any(m in text for m in CRASH_DUMP_MARKERS))


def from_transcript(limit, before):
    if not os.path.exists(TRANSCRIPT):
        return None
    rows = []
    with open(TRANSCRIPT, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            if is_crash_dump(r):
                continue
            rows.append(r)
    if not rows:
        return None
    if before:
        rows = [r for r in rows if str(r.get("ts", "")) < before]
    rows = rows[-limit:]
    out = []
    for r in rows:
        who = "Claude" if r.get("role") == "assistant" else "You"
        out.append((str(r.get("ts", ""))[:16], who, (r.get("text") or "").strip()))
    return out


def strip_framing(text):
    # drop the bot's 🤖🤖🤖 header/footer + "(i/n)" chunk markers if present
    lines = [ln for ln in text.split("\n")
             if ln.strip().rstrip("0123456789 ()/") not in (MARKER * 3, "")]
    return "\n".join(lines).strip() or text.strip()


def from_bridge(chat, limit, before):
    con = sqlite3.connect(f"file:{BRIDGE_DB}?mode=ro", uri=True, timeout=10)
    q = "SELECT rowid, content, timestamp, media_type FROM messages WHERE chat_jid=?"
    params = [chat]
    if before:
        q += " AND timestamp < ?"
        params.append(before)
    q += " ORDER BY rowid DESC LIMIT ?"
    params.append(limit)
    rows = con.execute(q, params).fetchall()
    rows.reverse()
    out = []
    for _rid, content, ts, media in rows:
        content = (content or "").strip()
        if not content and media:
            content = f"<{media}>"
        who = "Claude" if content.startswith(MARKER) else "You"
        if who == "Claude":
            content = strip_framing(content)
        out.append((str(ts or "")[:16], who, content))
    return out


def main():
    ap = argparse.ArgumentParser(description="recent My-Claude group chat history")
    ap.add_argument("--chat", default=DEFAULT_CHAT, help="chat JID")
    ap.add_argument("--limit", type=int, default=25, help="how many recent messages (default 25)")
    ap.add_argument("--before", default=None,
                    help="only messages before this timestamp (paging deeper)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args()

    rows = from_transcript(args.limit, args.before)
    if rows is None:
        rows = from_bridge(args.chat, args.limit, args.before)

    if args.json:
        json.dump([{"ts": t, "who": w, "text": x} for t, w, x in rows],
                  sys.stdout, ensure_ascii=False, indent=2)
        print()
        return

    if not rows:
        print("(no history)")
        return
    for ts, who, text in rows:
        text = text.replace("\n", "\n     ")
        print(f"[{ts}] {who}: {text}")


if __name__ == "__main__":
    main()
